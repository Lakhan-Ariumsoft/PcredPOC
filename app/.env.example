# ── Provider toggle ──────────────────────────────────────────────
# Set to "openai" or "qwen" to switch which credential set below is active.
LLM_PROVIDER=qwen

# ── OpenAI ───────────────────────────────────────────────────────
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_DOCLING_MODEL=gpt-4o-mini
OPENAI_EXTRACTION_MODEL=gpt-4o-mini

# ── Qwen (HuggingFace Inference Endpoint, or LM Studio locally) ──
QWEN_BASE_URL=http://localhost:1234/v1
QWEN_API_KEY=
QWEN_DOCLING_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
QWEN_EXTRACTION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

OUTPUT_DIR=app/outputs
LOG_DIR=app/outputs/logs
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=120
